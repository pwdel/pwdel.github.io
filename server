#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8003}"
URL="http://${HOST}:${PORT}/"
PID_FILE="${ROOT}/.server.pid"
LOG_FILE="${ROOT}/.server.log"

usage() {
  cat <<USAGE
Usage: ./server <command>

Commands:
  start    Start the local preview server
  stop     Stop the local preview server
  restart  Restart the local preview server
  status   Show whether the local preview server is running
  help     Show this help text

Serves this site locally at ${URL}

Environment:
  HOST  Bind address, default: 127.0.0.1
  PORT  Port, default: 8003
USAGE
}

pid() {
  [[ -f "$PID_FILE" ]] && sed -n '1p' "$PID_FILE" || true
}

is_running() {
  local current_pid
  current_pid="$(pid)"
  [[ "$current_pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$current_pid" 2>/dev/null
}

start() {
  if is_running; then
    echo "Already serving ${URL} with pid $(pid)."
    return
  fi

  rm -f "$PID_FILE"

  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Port ${PORT} is already in use."
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN
    exit 1
  fi

  nohup python3 -m http.server "$PORT" --bind "$HOST" --directory "$ROOT" >"$LOG_FILE" 2>&1 &
  echo "$!" >"$PID_FILE"
  sleep 0.3

  if ! is_running; then
    echo "Server failed to start. See ${LOG_FILE}."
    exit 1
  fi

  echo "Serving ${ROOT} at ${URL}"
  echo "Log: ${LOG_FILE}"
}

stop() {
  if ! is_running; then
    rm -f "$PID_FILE"
    echo "No local preview server is running."
    return
  fi

  local current_pid
  current_pid="$(pid)"
  kill "$current_pid"

  for _ in {1..20}; do
    if ! kill -0 "$current_pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      echo "Stopped local preview server."
      return
    fi
    sleep 0.1
  done

  echo "Server did not stop after SIGTERM; pid ${current_pid} is still running."
  exit 1
}

status() {
  if is_running; then
    echo "Serving ${URL} with pid $(pid)."
  else
    rm -f "$PID_FILE"
    echo "No local preview server is running."
  fi
}

case "${1:-}" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    start
    ;;
  status)
    status
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: $1"
    usage
    exit 2
    ;;
esac
